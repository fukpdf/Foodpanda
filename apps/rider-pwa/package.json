    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@deliveryos/shared-types": "workspace:*",
    "@deliveryos/shared-utils": "workspace:*",
    "@deliveryos/ui-system": "workspace:*",
    "next": "15.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3"
  }
}
