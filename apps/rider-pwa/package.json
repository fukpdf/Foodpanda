{
  "name": "@deliveryos/rider-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Rider delivery app PWA for managing pickups and deliveries on DeliveryOS",
  "scripts": {
    "dev": "next dev -p ${PORT:-3003}",
    "build": "next build",
