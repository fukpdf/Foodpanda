NODE_ENV=development
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://user:password@localhost:5432/deliveryos_auth

JWT_SECRET=replace-with-secure-32-char-min-secret-key
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
JWT_ISSUER=deliveryos-auth
JWT_AUDIENCE=deliveryos-api

BCRYPT_ROUNDS=12

REDIS_URL=redis://localhost:6379

COOKIE_SECRET=replace-with-secure-32-char-min-cookie-secret
COOKIE_SECURE=false
COOKIE_DOMAIN=

RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WINDOW_MS=60000
